{
  "persistence_single_dir": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "persistence": {
        "directories": "~/.config/tests/nested/deep"
      }
    },
    "containerUser": "vscode"
  },
  "persistence_single_file": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "persistence": {
        "files": "~/.zshrc"
      }
    },
    "containerUser": "vscode"
  },
  "persistence_seed_existing_file": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "persistence": {
        "files": "~/.bashrc"
      }
    },
    "containerUser": "vscode"
  },
  "persistence_bind": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "persistence": {
        "bindDirectories": "~/.config/bindtest",
        "bindFiles": "~/.bashrc"
      }
    },
    "containerUser": "vscode",
    "privileged": true
  }
}
